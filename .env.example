# ──────────────────────────────────────────────────────────────
# 제주 데이터 길잡이 환경변수 예시
# 이 파일을 복사해 `.env` 로 저장한 뒤 값을 채우세요. (.env 는 git에 올라가지 않습니다)
# ──────────────────────────────────────────────────────────────

# [필수] Anthropic Claude API 키 (https://console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=sk-ant-...

# [선택] 사용할 Claude 모델 (기본값: claude-opus-5-5)
JEJU_AGENT_MODEL=claude-opus-5-5
# [선택] 추론 노력 수준: low | medium | high | xhigh | max (기본값: medium)
JEJU_AGENT_EFFORT=medium
# [선택] 한 질문당 최대 도구 호출 횟수 (기본값: 25)
JEJU_AGENT_MAX_STEPS=25
# [선택] 분석 코드 실행 제한 시간(초) (기본값: 90)
JEJU_AGENT_SANDBOX_TIMEOUT=90
# [선택] 안전 분류기 거절 시 서버측 대체 모델 사용: default | off (기본값: default)
JEJU_AGENT_FALLBACKS=default
# [선택] 모델의 단계별 사고(적응형 thinking) 사용: adaptive | off (기본값: adaptive)
JEJU_AGENT_THINKING=adaptive
# [선택] 사고 요약을 화면에 표시: summarized | omitted (기본값: summarized)
JEJU_AGENT_THINKING_DISPLAY=summarized

# [선택] 제주데이터허브 Open API 프로젝트 키
#   제주데이터허브(https://www.jejudatahub.net) 로그인 → 마이페이지 → 프로젝트 생성 후 발급
#   키가 없으면 data/raw 에 내려받은 파일 또는 data/samples 의 샘플 데이터로 동작합니다.
JEJUDATAHUB_PROJECT_KEY=
# [선택] Open API 기본 URL (기본값: https://open.jejudatahub.net/api/proxy)
JEJUDATAHUB_BASE_URL=https://open.jejudatahub.net/api/proxy
